@{
    ViewData["Title"] = "Home";
}

<div class="row g-4 align-items-center">
    
    <!-- LEFT SIDE: TEXT + BUTTONS -->
    <div class="col-lg-7">
        <div class="p-4 p-md-5 bg-white shadow-sm rounded-4 border h-100">

            <h1 class="display-6 fw-bold mb-3">
                Joel Hilton’s Movie Collection
            </h1>

            <p class="text-muted mb-4">
                Add movies to the collection and view the full list. 
                This site uses ASP.NET MVC + EF Core (model-first) + SQLite.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-dark btn-lg px-4" 
                   asp-controller="Movies" 
                   asp-action="Add">
                    Add a Movie
                </a>

                <a class="btn btn-outline-dark btn-lg px-4" 
                   asp-controller="Movies" 
                   asp-action="Index">
                    View Movie List
                </a>
            </div>

        </div>
    </div>

    <!-- RIGHT SIDE: JOEL IMAGE -->
    <div class="col-lg-5">
        <div class="text-center p-4 bg-white shadow-sm rounded-4 border">

            <img src="~/img/joel.jpg"
                 class="img-fluid rounded-4 shadow"
                 alt="Joel Hilton"
                 style="max-height: 450px; object-fit: cover;" />

        </div>
    </div>

</div>