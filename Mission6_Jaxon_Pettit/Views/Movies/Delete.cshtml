@model Mission6_Jaxon_Pettit.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h4 fw-bold text-danger mb-2">Delete Movie</h1>
                    <p class="text-muted mb-4">Are you sure you want to delete this movie? This can’t be undone.</p>

                    <div class="mb-4">
                        <div class="fw-semibold">@Model.Title (@Model.Year)</div>
                        <div class="text-muted">
                            Category: @(Model.Category?.CategoryName ?? "—") |
                            Director: @(string.IsNullOrWhiteSpace(Model.Director) ? "—" : Model.Director) |
                            Rating: @(string.IsNullOrWhiteSpace(Model.Rating) ? "None" : Model.Rating)
                        </div>
                    </div>

                    <form asp-controller="Movies" asp-action="DeleteConfirmed" asp-route-id="@Model.MovieId" method="post">
                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">Yes, Delete</button>
                            <a class="btn btn-outline-secondary btn-lg" asp-controller="Movies" asp-action="Index">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>